{
  "name": "dsh-plugin-updater",
  "version": "0.1.6",
  "description": "Check for updates to user-installed DSH plugins, show update badges, and update on demand.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/jabingu/dsh-plugin-updater.git" },
  "homepage": "https://github.com/jabingu/dsh-plugin-updater#readme",
  "bugs": { "url": "https://github.com/jabingu/dsh-plugin-updater/issues" },
  "engines": { "node": "^22.19.0 || >=24.0.0", "dsh": "0.2.1-rc.5 || >=0.2.2-rc.1 <0.2.3-0" },
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["lib", "locale", "docs", "assets", "cordis.patch.yml", "README.md", "README.en.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-api-gateway", "@deepseek-ai/dsh-api-remotes", "@deepseek-ai/dsh-client-ui-plugin-manager"]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5 || ~4.1.0",
    "@deepseek-ai/dsh": "0.2.1-rc.5 || >=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.5 || >=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.5 || >=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.5 || >=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.5 || >=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.5 || >=0.2.2-rc.1 <0.2.3-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh": { "optional": true },
    "@deepseek-ai/dsh-app-boot": { "optional": true },
    "@deepseek-ai/dsh-atomic-write": { "optional": true },
    "@deepseek-ai/dsh-home-paths": { "optional": true },
    "@deepseek-ai/dsh-subprocess": { "optional": true },
    "@deepseek-ai/dsh-typert-protocol": { "optional": true }
  },
  "dependencies": { "execa": "9.6.0", "semver": "7.7.3", "yaml": "2.8.1" },
  "devDependencies": { "jsdom": "27.0.1", "react": "18.3.1", "react-dom": "18.3.1" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "verify:sdk": "node scripts/verify-sdk.mjs"
  }
}
